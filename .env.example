# Copy to .env (git-ignored) or set as environment variables in the cloud
# environment. Never commit real values.

# Public — safe to expose. shared.js currently ships the legacy anon JWT;
# it is being moved to the new publishable key (sb_publishable_...).
SUPABASE_URL=https://jtsifootrchbsgrldfxk.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string, lets the agent apply SQL migrations itself.
# Supabase > Project Settings > Database > Connection string > URI (session pooler).
SUPABASE_DB_URL=

# Bypasses RLS. Only needed for seed_products.mjs. Use a NEW secret key
# (sb_secret_...), never the legacy service_role JWT — that one leaked.
# See CLAUDE.md rule 8 for the safe revocation order.
SUPABASE_SERVICE_KEY=

# Optional: read deployments/logs from Vercel. Deploys happen on push anyway.
VERCEL_TOKEN=
