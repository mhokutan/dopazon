# Copy to .env (git-ignored) or set as environment variables in the cloud
# environment. Never commit real values.

# Public — already in shared.js, safe to expose.
SUPABASE_URL=https://jtsifootrchbsgrldfxk.supabase.co
SUPABASE_ANON_KEY=

# Postgres connection string, lets the agent apply SQL migrations itself.
# Supabase > Project Settings > Database > Connection string > URI (session pooler).
SUPABASE_DB_URL=

# Bypasses RLS. Only needed for seed_products.mjs. Use a freshly ROTATED key.
SUPABASE_SERVICE_KEY=

# Optional: read deployments/logs from Vercel. Deploys happen on push anyway.
VERCEL_TOKEN=
